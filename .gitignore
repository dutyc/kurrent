# 本地运行时配置（含真实 token），仓库只保留 *.example 模板
storager/.env
# 节点声明式配置（kurrent join 生成，含 bootstrap token，不入库；模板见 kurrent.yaml.example）
storager/kurrent.yaml
# 一次性引导凭据文件（kurrent join 写入，不入库）
storager/bootstrap/
control_plane/config/agents.yml
# 控制面声明式配置（运行时文件不入库；模板见 kurrent.yaml.example）
control_plane/kurrent.yaml
control_plane/state/settings.json

# 内部架构规划（不入版本库）
blueprint/

# 运行时状态、日志与租约（容器/Agent 运行生成，不入库）
control_plane/state/operations.jsonl
control_plane/state/workers.yml
control_plane/state/devices.yml
# NVMe-oF 认证凭据库（DHHC-1 密钥，按 Worker 跟盘，运行时生成）
control_plane/state/credentials.yml
# 凭据推送状态台账（运行时生成，只存所推密钥的审计哈希，不入库）
control_plane/state/credential-push.yml
# TOFU 自签证书（控制面启动时自动生成，含私钥，不入库）
control_plane/state/certs/
# 组件 PKI 与 bootstrap token（运行时签发，含私钥与 token 摘要，不入库）
control_plane/state/pki/
# 母盘标签台账（运行时生成，不入库）
control_plane/state/masters.yml
# 管理凭据（admin.conf 扁平 YAML / 会话密钥，控制面启动自举，含私钥，不入库）
control_plane/state/admin.conf
control_plane/state/session.key
# 根级误落盘防再犯：未设 env 重定向的本地运行以仓库根为 cwd 时，control_plane 默认相对路径会在此落盘（测试产物）
/state/
/config/
storager/agent/logs/ops.jsonl
# DHHC-1 明文凭据缓存（运行时生成，mode 0600，不入库）
storager/agent/logs/nvmet-credentials.json
dnsmasq/dnsmasq.leases
dnsmasq/dhcp-hosts.conf
dnsmasq/dnsmasq.conf
