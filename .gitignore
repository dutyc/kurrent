node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
app/node_modules
.npm-cache/

# 本地资料（设计蓝图、审计报告、个人交付物、旧文档快照、上游参考源码）
# 不属于产品源码树，统一放这里，不入库
.local/
# Python 虚拟环境
.venv/
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# VitePress 构建产物
docs/.vitepress/cache/
docs/.vitepress/dist/
webui/app/node_modules

# WebUI 构建产物（vite build 生成，不入库）
webui/app/dist/

# CLI 构建产物（go build -o ../bin/kurrent .，不入库）
/bin/

# iPXE 引导二进制（部署时从固件仓构建产物放入 tftp 根目录，不入库）
tftp/*.efi
tftp/*.kpxe
tftp/*.bak

.DS_Store
Thumbs.db
*.swp
*.swo
*~
.stfolder/
.stignore
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
# 运行数据（盘镜像），不入库；建议放到仓库外的数据盘
storager_img/


.env.local
.env.*.local
webui/app/.env
.qoderignore

# 以下为旧布局（运行时状态在仓库内）的忽略项，保留用于 --adopt-state 迁移前后的仓库；
# 新部署的运行时状态位于 ~/.local/state/kurrent（KURRENT_STATE_DIR），不在本仓库内。
# 节点声明式配置（kurrent join 生成，不入库；模板见 kurrent.yaml.example）
storager/kurrent.yaml
# 节点身份状态（join 写入，不入库；备份时需保留）
storager/state/
# 一次性引导凭据文件（kurrent join 写入，不入库）
storager/bootstrap/
control_plane/config/agents.yml
# 控制面声明式配置（运行时文件不入库；模板见 kurrent.yaml.example）
control_plane/kurrent.yaml
control_plane/state/settings.json

# 运行时状态、日志与租约（容器/Agent 运行生成，不入库）
control_plane/state/operations.jsonl
control_plane/state/workers.yml
control_plane/state/devices.yml
# NVMe-oF 认证凭据库（DHHC-1 密钥，按 Worker 跟盘，运行时生成）
control_plane/state/credentials.yml
# 凭据推送状态台账（运行时生成，只存所推密钥的审计哈希，不入库）
control_plane/state/credential-push.yml
# TOFU 自签证书（控制面启动时自动生成，含私钥，不入库）
control_plane/state/certs/
# 组件 PKI 与 bootstrap token（运行时签发，含私钥与 token 摘要，不入库）
control_plane/state/pki/
# 母盘标签台账（运行时生成，不入库）
control_plane/state/masters.yml
# 管理凭据（admin.conf 扁平 YAML / 会话密钥，控制面启动自举，含私钥，不入库）
control_plane/state/admin.conf
control_plane/state/session.key
# 管理面用户组映射（CN → groups，首次启动自举 admin，其后运维维护，不入库）
control_plane/state/users.yml
# 服务端会话登记（key = sha256(jti)，运行时生成，不入库）
control_plane/state/sessions.yml
# 认证审计与告警（运行时生成，含主体/证书证据，不入库）
control_plane/state/audit.jsonl
# 整个状态目录整体忽略：运行时台账、备份与后续新增文件都不入库
control_plane/state/
# 根级误落盘防再犯：未设 env 重定向的本地运行以仓库根为 cwd 时，control_plane 默认相对路径会在此落盘（测试产物）
/state/
/config/
storager/agent/logs/ops.jsonl
# DHHC-1 明文凭据缓存（运行时生成，mode 0600，不入库）
storager/agent/logs/nvmet-credentials.json
dnsmasq/dnsmasq.leases
dnsmasq/dhcp-hosts.conf
dnsmasq/dnsmasq.conf

# Secure Boot 签名产物（由固件仓构建后放入，不入库）
tftp/secureboot/
