#!ipxe

# 唯一的 TFTP 引导脚本：只做一次 HTTPS 跳转。
# https-port 必须先在这里设置（本文件先于 boot.ipxe.cfg 执行），并与
# docker-compose 的 KURRENT_HTTPS_PORT、boot.ipxe.cfg 的 set https-port 保持一致。
set https-port 443

# 取回配置：变量、设备身份链与 /boot-vars 都在这个脚本里，之后全链 HTTPS + TOFU
chain --autofree https://${next-server}:${https-port}/tftp/boot.ipxe.cfg ||

# 配置成功时 ${menu-url} 已设置；失败时为空，chain 直接失败
chain --replace --autofree ${menu-url} ||
